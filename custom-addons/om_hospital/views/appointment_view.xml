<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- decoration-success green
    decoration-danger red
    decoration-warning orange
    decoration-info blue -->

    <!-- Activity View -->
    <record id="view_hospital_appointment_activity" model="ir.ui.view">
        <field name="name">hospital.appointment.activity</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <activity string="Appointment Activities">
                <field name="patient_id"/>
                <field name="ref"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('hospital.patient', 'image', record.patient_id.raw_value)" 
                             t-att-title="record.patient_id.value" 
                             t-att-alt="record.patient_id.value"/>
                        <div>
                            <field name="ref" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" 
                  decoration-info="state == 'draft'"
                  decoration-danger="state == 'cancel'"
                  decoration-warning="state == 'in_consultation'"
                  sample="1"
                  multi_edit="true">
                <field name="patient_id"/>
                <!-- dynamic tree view optional fields -->
                <field name="ref" optional="show"/>
                <field name="doctor_id" widget="many2one_avatar"/>
                <field name="gender" optional="show"/>
                <field name="appointment_time"/>
                <field name="booking_date" optional="show"/>
                <field name="activity_ids" widget="list_activity"/>
                <field name="state" 
                        decoration-success="state == 'done'"
                        decoration-info="state == 'draft'"
                        decoration-danger="state == 'cancel'"
                        decoration-warning="state == 'in_consultation'"
                        widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Hospital Appointment">
                <!-- Header Status widget -->
                <header>
                    <button name="action_in_consultation" string="In Consultation" type="object" states="draft" class="oe_highlight"/>
                    <!-- only available this button when states in_consultation -->
                    <button name="action_done" string="Done" type="object" states="in_consultation" class="oe_highlight" data-hotkey="v"/>
                    <!-- call an external function from wizard model, require type action , set context default_appointment_id -->
                    <button name="%(om_hospital.action_cancel_appointment_wizard)d" string="Cancel" 
                        context="{'default_appointment_id': active_id}"
                        type="action" states="draft,in_consultation" data-hotkey="c"/>
                    <!-- <button name="action_cancel" string="Cancel" type="object" states="draft,in_consultation" data-hotkey="c"/> -->
                    <button name="action_draft" string="Reset to Draft" type="object" states="cancel"/>
                    <!-- enable fields clickable options="{'clickable': '1'}" -->
                    <field name="state" widget="statusbar" nolabel="1" 
                            statusbar_visible="draft,in_consultation,done,cancel"/>
                </header>
                <sheet>
                    <!-- Start of Priority Section appears -->
                    <div>
                        <h1>
                            <field name="priority" widget="priority" class="mr-3"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="ref"/>
                            <field name="gender"/>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                            <field name="booking_date" help="Booking date for the appointment" default_focus="1"/>
                        </group>
                        <group>
                            <!-- Hide Sales Price, once you activate debug mode it will be shown -->
                            <field name="hide_sales_price" groups="base.group_no_one"/>
                            <field name="appointment_time"/>
                            <!-- type="object" calls function -->
                            <button name="action_test" string="Start Consultation"
                                        help="This button will change the state to 'In Consultation'"
                                        groups="base.group_no_one"
                                        confirm="Are you sure you want to start the consultation?"
                                        type="object" class="oe_highlight"/>
                            <!-- type="action" calls an action -->
                            <button name="%(om_hospital.action_hospital_patient)d" string="Action button"
                                        help="This button will open the patient form view"
                                        groups="base.group_no_one"
                                        confirm="Are you sure you want to open the patient form view?"
                                        type="action" class="oe_highlight"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription" name="prescription">
                            <!-- Prescription details with collaborative editing -->
                            <field name="prescription" placeholder="Enter prescription details here..."
                            options="{'collaborative': true, 'resizable': true, 'codeview': true}"/>
                        </page>
                        <page string="Pharmacy" name="pharmacy">
                            <field name="pharmacy_line_ids">
                                <tree editable="top">
                                    <field name="product_id"/>
                                    <field name="price_unit" attrs="{'column_invisible': [('parent.hide_sales_price', '=', True)]}"/>
                                    <field name="qty"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="price_unit" attrs="{'column_invisible': [('parent.hide_sales_price', '=', True)]}"/>
                                        <field name="qty"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <notebook>

                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="base.group.user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View using action_hospital_appointment -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form,activity</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first appointment
            </p>
        </field>
    </record>

    <!-- Menuitem calling action_hospital_appointment -->
    <menuitem id="menu_appointment"
              name="Appointments"
              action="action_hospital_appointment"
              parent="menu_appointment_master"
              sequence="10"/>
</odoo>