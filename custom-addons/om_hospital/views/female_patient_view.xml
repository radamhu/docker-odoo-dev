<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_hospital_female_patient" model="ir.actions.act_window">
        <field name="name">Female Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form</field>
        <!-- Context : default gender when creating new female patients -->
        <field name="context">{ 'default_gender': 'female', 'default_age': 25 }</field>
        <!-- domain : only shows female patients from model -->
        <field name="domain">[('gender', '=', 'female')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first female patient
            </p>
        </field>
    </record>

    <menuitem id="menu_female_patient"
              name="Female Patients"
              action="action_hospital_female_patient"
              parent="menu_patient_master"
              sequence="20"/>
</odoo>